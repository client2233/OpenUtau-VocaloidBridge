<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OpenUtauDirectory Condition="'$(OpenUtauDirectory)' == ''">/opt/openutau</OpenUtauDirectory>
    <OpenUtauTargetFramework Condition="'$(OpenUtauTargetFramework)' == '' and Exists('$(OpenUtauDirectory)/OpenUtau.Core.dll') and $([System.IO.File]::ReadAllText('$(OpenUtauDirectory)/OpenUtau.Core.dll').Contains('.NETCoreApp,Version=v8.0'))">net8.0</OpenUtauTargetFramework>
    <OpenUtauTargetFramework Condition="'$(OpenUtauTargetFramework)' == '' and Exists('$(OpenUtauDirectory)/OpenUtau.Core.dll') and $([System.IO.File]::ReadAllText('$(OpenUtauDirectory)/OpenUtau.Core.dll').Contains('.NETCoreApp,Version=v9.0'))">net9.0</OpenUtauTargetFramework>
    <OpenUtauTargetFramework Condition="'$(OpenUtauTargetFramework)' == ''">net10.0</OpenUtauTargetFramework>
    <TargetFramework>$(OpenUtauTargetFramework)</TargetFramework>
    <!-- Detect the optional interface type in the selected installed assembly.
         Override OpenUtauRenderEvents=true/false for an unusual fork. -->
    <OpenUtauRenderEvents Condition="'$(OpenUtauRenderEvents)' == '' and Exists('$(OpenUtauDirectory)/OpenUtau.Core.dll')">$([System.IO.File]::ReadAllText('$(OpenUtauDirectory)/OpenUtau.Core.dll').Contains('RenderPhraseEvents'))</OpenUtauRenderEvents>
    <DefineConstants Condition="'$(OpenUtauRenderEvents)' == 'True'">$(DefineConstants);OPENUTAU_RENDER_EVENTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Smoke/**/*.cs" />
    <Reference Include="OpenUtau.Core"><HintPath>$(OpenUtauDirectory)/OpenUtau.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NetMQ"><HintPath>$(OpenUtauDirectory)/NetMQ.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
