<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OpenUtauDirectory Condition="'$(OpenUtauDirectory)' == ''">/opt/openutau</OpenUtauDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Smoke/**/*.cs" />
    <Reference Include="OpenUtau.Core"><HintPath>$(OpenUtauDirectory)/OpenUtau.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
